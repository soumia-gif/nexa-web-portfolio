# ===================================================
# PORTFOLIO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables for your deployment
# NEVER commit your real .env file with production secrets to Git!
# ===================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port
PORT=5000

# Master MongoDB Connection URI
# Local format: mongodb://127.0.0.1:27017/portfolio_db
# Atlas format: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_db

# Cryptographically Secure JWT Secret Key (Minimum 32 characters)
# Generate via: openssl rand -hex 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_strong_random_jwt_secret_key_change_me_in_production

# Optional Secret Gate Key for Admin Portal Access Protection
# Required only if you want an extra security layer over the admin route
ADMIN_SECRET_KEY=your_optional_admin_secret_gate_key_change_me

# Initial Admin Seeding Credentials (Used only on initial seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password_before_seeding

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173
